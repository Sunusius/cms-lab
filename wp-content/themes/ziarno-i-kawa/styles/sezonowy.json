{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "title": "Sezonowy",
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#FDF8F3", "name": "Ciepły krem (Tło)" },
        { "slug": "contrast", "color": "#241711", "name": "Gorzka czekolada (Tekst)" },
        { "slug": "primary", "color": "#9E3E14", "name": "Korzenny cynamon (Akcent główny)" },
        { "slug": "secondary", "color": "#6B2737", "name": "Grzana śliwka (Akcent dodatkowy)" },
        { "slug": "surface", "color": "#F3E7DC", "name": "Korzenne latte (Karty i sekcje)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      }
    }
  }
}
