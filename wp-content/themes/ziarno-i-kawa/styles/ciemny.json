{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "title": "Ciemny",
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#16110E", "name": "Ciemne espresso (Tło)" },
        { "slug": "contrast", "color": "#F5EFE6", "name": "Jasna śmietanka (Tekst)" },
        { "slug": "primary", "color": "#E59A6C", "name": "Złota crema (Akcent główny)" },
        { "slug": "secondary", "color": "#8FB396", "name": "Jasna zieleń kawowca (Akcent dodatkowy)" },
        { "slug": "surface", "color": "#231B16", "name": "Palone ziarno (Karty i sekcje)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      }
    }
  }
}
