{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": true,
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "pl_PL"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyfive"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "contact-form-7"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "wp-cli",
      "command": "wp option update blogname 'Ziarno&Kawa'"
    },
    {
      "step": "wp-cli",
      "command": "wp post delete 1 --force"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Strona główna' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='O nas' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Oferta' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Kontakt' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Polityka prywatności' --post_status=publish"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $home = get_page_by_path('strona-glowna'); if ($home) { update_option('show_on_front', 'page'); update_option('page_on_front', $home->ID); }"
    }
  ]
}